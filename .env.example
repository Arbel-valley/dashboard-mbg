# Salin menjadi .env HANYA kalau perlu mengganti default (opsional).
# Mengganti password setelah volume terbentuk TIDAK berefek -> docker compose down -v dulu.

POSTGRES_PASSWORD=postgres_dev_123
APP_PASSWORD=app_dev_123
FDW_PASSWORD=fdw_dev_123
AI_PASSWORD=ai_dev_123
REPLICATOR_PASSWORD=repl_dev_123

# Port di laptop (ubah kalau bentrok, mis. dengan PostgreSQL lokal di 5432-an)
PORT_PUSAT=5440
PORT_REPLICA=5441
PORT_BARAT=5442
PORT_TENGAH=5443
PORT_TIMUR=5444
PORT_BACKEND=8000

# Origin frontend yang boleh memanggil API (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000
